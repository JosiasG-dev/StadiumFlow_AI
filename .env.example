APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
DEFAULT_SEED=42
DEFAULT_REPLICAS=10
MAX_REPLICAS=30

# Proveedor del agente: "heuristic" (local) o "orchestrate" (IBM watsonx)
ADVISOR_PROVIDER=heuristic

# IBM watsonx Orchestrate (solo necesario si ADVISOR_PROVIDER=orchestrate)
# ORCHESTRATE_URL=https://<region>.assistant.watson.cloud.ibm.com
# ORCHESTRATE_API_KEY=<tu-api-key>
# ORCHESTRATE_AGENT_ID=<id-del-agente>
# ORCHESTRATE_TIMEOUT=10
